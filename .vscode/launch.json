{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: run debug",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "module": "accelerate",
            "args": [
                "launch"
                "--config_file", "accelerate/single_gpu_config.yaml",
                "scripts/model_training/sft.py",
                "training_configs/sft/sft-yandex-lora-GrandmasterRAG_jf.yaml"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${env:PYTHONPATH}"
            },
            "justMyCode": true
        }, 
        {
            "name": "Run: run train",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/scripts/model_training/sft.py",
            "args": [
                "training_configs/sft/sft-yandex-lora-GrandmasterRAG_jf.yaml"
                    ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${env:PYTHONPATH}"
            },
            "justMyCode": false
        },        
        {
            "name": "Run: train low memory",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "console": "integratedTerminal",
            "args": [
                "--substep", "2",
                "--batch-size", "1",
                "--chunk-size", "10000",
                "--warmup", "500",
                "--save-dir", "/home/m.utrobin/tmp/disk_train",
                "/home/m.utrobin/datasets/datasets.epfl.ch1/disk-data"],
            "justMyCode": false
        },        
    ]
}